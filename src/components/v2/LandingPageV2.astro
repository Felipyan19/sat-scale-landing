<script>
  if (typeof window !== 'undefined') {
    window.addEventListener('DOMContentLoaded', () => {
      const emitAnalyticsEvent = (name: string, detail: Record<string, unknown> = {}) => {
        window.dispatchEvent(new CustomEvent('satscale:analytics', { detail: { event: name, ...detail } }));
        const dataLayer = (window as typeof window & { dataLayer?: Array<Record<string, unknown>> }).dataLayer;
        dataLayer?.push({ event: name, ...detail });
      };

      const navbar = document.getElementById('navbar');
      const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-target]'));
      const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id]'));
      const ctaLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-contact-intent]'));

      ctaLinks.forEach((link) => {
        link.addEventListener('click', () => {
          emitAnalyticsEvent('cta_click', {
            intent: link.dataset.contactIntent ?? 'info',
            location: link.textContent?.trim() || 'unknown'
          });
        });
      });

      const whatsappLink = document.querySelector<HTMLAnchorElement>('.whatsapp-float');
      whatsappLink?.addEventListener('click', () => {
        emitAnalyticsEvent('whatsapp_click', { location: 'floating_button' });
      });

      if (!navLinks.length || !sections.length) return;

      const setActive = (id: string) => {
        navLinks.forEach((link) => {
          if (link.dataset.navTarget === id) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      };

      const getSectionFromHash = () => {
        const hash = window.location.hash.replace('#', '');
        return sections.some((section) => section.id === hash) ? hash : '';
      };

      const scrollToSectionAnchor = (id: string, behavior: ScrollBehavior) => {
        const section = sections.find((item) => item.id === id);
        if (!section) return;
        const anchor = section.querySelector<HTMLElement>('[data-scroll-anchor]') ?? section;
        const navbarHeight = navbar?.offsetHeight ?? 0;
        const top = anchor.getBoundingClientRect().top + window.scrollY - navbarHeight - 24;
        window.scrollTo({ top: Math.max(0, top), behavior });
      };

      const syncFromViewport = () => {
        const fromHash = getSectionFromHash();
        if (fromHash) {
          setActive(fromHash);
          return;
        }

        const offset = 160;
        let current = sections[0]?.id ?? '';
        sections.forEach((section) => {
          if (section.offsetTop - offset <= window.scrollY) {
            current = section.id;
          }
        });
        if (current) setActive(current);
      };

      navLinks.forEach((link) => {
        link.addEventListener('click', (event) => {
          const id = link.dataset.navTarget;
          if (!id) return;
          event.preventDefault();
          history.pushState(null, '', `#${id}`);
          setActive(id);
          scrollToSectionAnchor(id, 'smooth');
          emitAnalyticsEvent('section_navigation', { target: id });
        });
      });

      window.addEventListener('hashchange', () => {
        const id = getSectionFromHash();
        if (id) {
          setActive(id);
          scrollToSectionAnchor(id, 'auto');
        } else {
          syncFromViewport();
        }
      });
      window.addEventListener('scroll', syncFromViewport, { passive: true });

      const initialHash = getSectionFromHash();
      if (initialHash) {
        setActive(initialHash);
        window.requestAnimationFrame(() => scrollToSectionAnchor(initialHash, 'auto'));
      } else {
        syncFromViewport();
      }
    });
  }
</script>

<script>
  if (typeof window !== 'undefined') {
